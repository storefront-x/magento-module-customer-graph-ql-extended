{
    "name": "storefront-x/magento-module-customer-graph-ql-extended",
    "description": "Magento 2 module validation customer token",
    "homepage": "https://github.com/storefront-x/magento-module-customer-graph-ql-extended",
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": ">=7.4",
        "magento/framework": "*",
        "magento/module-graph-ql": "*",
        "magento/module-customer-graph-ql": "*",
        "magento/module-store": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "StorefrontX\\CustomerGraphQlExtended\\": ""
        }
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1"
    }
}
